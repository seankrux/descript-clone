{
  "manifest_version": 3,
  "name": "Descript Companion - Screen, Cam & Tab Recorder",
  "version": "1.0.0",
  "description": "Enterprise-grade screen, floating webcam bubble, and tab audio recorder with instant Descript web studio timeline sync.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Record with Descript Companion"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
